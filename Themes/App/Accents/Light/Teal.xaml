<!-- KillerPDF's own Light Teal accent values: keys the kit accent overlay does not carry.
     AppDerivedTokens (Services/AppTheme.cs) adds them; kit keys keep the kit's value. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="RadioAccentText" Color="#0B6C69" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#D5F1F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#0B6C69" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#D5F1F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B6C69" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterAccentBrush" Color="#0B6B68"/>
</ResourceDictionary>
