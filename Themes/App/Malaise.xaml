<!-- KillerPDF's own Malaise theme values: keys only KillerPDF uses, and KillerPDF's own value
     where the family palette states a different one. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges them over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="ContentPaneBrush" Color="#303638" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterAccentBrush" Color="#FFB7C8"/>
    <SolidColorBrush x:Key="TextFieldBrush" Color="#FF232A2B" po:Freeze="True"/>
</ResourceDictionary>
