<!-- KillerPDF's own Mourning theme values: keys only KillerPDF uses, and KillerPDF's own value
     where the family palette states a different one. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges them over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="FooterAccentBrush" Color="#FF7696"/>
    <SolidColorBrush x:Key="RadioHoverFgBrush" Color="#FFFFA9BD" po:Freeze="True"/>
</ResourceDictionary>
